# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real secrets.

# ---------- Supabase ----------
# Supabase Dashboard -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# PUBLISHABLE key — starts with "sb_publishable_" (legacy name: anon). Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# SECRET key — starts with "sb_secret_" (legacy name: service_role). SERVER ONLY, bypasses RLS.
# These two MUST be different keys. The app refuses to start if the secret slot holds a publishable key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------- AppFolio Reports API (read-only) ----------
APPFOLIO_DB=scstudenthousing
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=

# ---------- App ----------
# The one email that is guaranteed the 'admin' role on first sign-in.
ADMIN_EMAIL=you@scstudenthousing.com
# Shared secret for the scheduled sync endpoint (/api/cron/sync-sales).
# Paste the 64-character output of running this in Terminal:  openssl rand -hex 32
CRON_SECRET=
# Shared secret n8n sends in the X-PQ-Key header to /api/pq-submit. Generate the same way:  openssl rand -hex 32
PQ_SUBMIT_KEY=
# Public URL of the deployed app (used for OAuth redirects). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Payment reminders (Accounting → Delinquency) ----------
# Microsoft Graph app (client credentials). RUN A needs the application permission Mail.ReadWrite
# (creates drafts), with an Exchange application access policy limiting it to the sender mailboxes.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "Polish with AI". Set the key of the provider you use; AI_PROVIDER/AI_MODEL are optional
# (default: first provider with a key; models claude-sonnet-5 / gpt-6-luna / gemini-3.8-flash).
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
