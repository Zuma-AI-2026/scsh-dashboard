# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real secrets.

# ---------- Supabase ----------
# Supabase Dashboard -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / "publishable" key. Safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key. SERVER ONLY. Bypasses RLS. Used by sync + auth callback.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AppFolio Reports API (read-only) ----------
APPFOLIO_DB=scstudenthousing
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=

# ---------- App ----------
# The one email that is guaranteed the 'admin' role on first sign-in.
ADMIN_EMAIL=you@scstudenthousing.com
# Shared secret for the scheduled sync endpoint (/api/cron/sync-sales).
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Public URL of the deployed app (used for OAuth redirects). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
